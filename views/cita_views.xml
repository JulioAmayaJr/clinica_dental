<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Cita Form -->
        <record id="view_clinica_cita_form" model="ir.ui.view">
            <field name="name">clinica.cita.form</field>
            <field name="model">clinica.cita</field>
            <field name="arch" type="xml">
                <form string="Cita Dental">
                    <header>
                        <button name="action_confirmar" string="Confirmar" type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'agendada')]}"/>
                        <button name="action_en_proceso" string="En Proceso" type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'confirmada')]}"/>
                        <button name="action_completar" string="Completar" type="object"
                                class="btn-success"
                                attrs="{'invisible': [('state', '!=', 'en_proceso')]}"/>
                        <button name="action_cancelar" string="Cancelar" type="object"
                                class="btn-danger"
                                attrs="{'invisible': [('state', 'in', ('completada','cancelada','no_asistio'))]}"/>
                        <button name="action_no_asistio" string="No Asistió" type="object"
                                attrs="{'invisible': [('state', 'in', ('completada','cancelada','no_asistio'))]}"/>
                        <button name="action_generar_venta" string="Generar Venta" type="object"
                                class="btn-secondary"
                                attrs="{'invisible': [('state', '!=', 'completada')]}"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="agendada,confirmada,en_proceso,completada"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="paciente_id" placeholder="Paciente..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información de la Cita">
                                <field name="dentista_id"/>
                                <field name="tipo_cita"/>
                                <field name="motivo"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                            <group string="Horario">
                                <field name="fecha_inicio"/>
                                <field name="fecha_fin"/>
                                <field name="duracion" readonly="1"/>
                            </group>
                        </group>
                        <group attrs="{'invisible': [('alergias_paciente', '=', False)]}">
                            <div class="alert alert-warning" role="alert">
                                <strong>⚠ Alergias del paciente:</strong>
                                <field name="alergias_paciente" readonly="1" nolabel="1"/>
                            </div>
                        </group>
                        <notebook>
                            <page string="Tratamientos">
                                <field name="tratamiento_ids">
                                    <list editable="bottom">
                                        <field name="tipo_tratamiento"/>
                                        <field name="pieza_dental"/>
                                        <field name="producto_id"/>
                                        <field name="cantidad"/>
                                        <field name="precio_unitario"/>
                                        <field name="subtotal" readonly="1"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notas">
                                <field name="notas" placeholder="Notas de la cita..."/>
                            </page>
                            <page string="Vínculos">
                                <group>
                                    <field name="calendar_event_id" readonly="1"/>
                                    <field name="sale_order_id" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Cita List -->
        <record id="view_clinica_cita_list" model="ir.ui.view">
            <field name="name">clinica.cita.list</field>
            <field name="model">clinica.cita</field>
            <field name="arch" type="xml">
                <list string="Citas" decoration-success="state == 'completada'"
                      decoration-warning="state == 'agendada'"
                      decoration-info="state == 'confirmada'"
                      decoration-danger="state in ('cancelada','no_asistio')">
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="paciente_id"/>
                    <field name="dentista_id"/>
                    <field name="tipo_cita"/>
                    <field name="motivo"/>
                    <field name="duracion"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completada'"
                           decoration-warning="state == 'agendada'"
                           decoration-info="state in ('confirmada','en_proceso')"
                           decoration-danger="state in ('cancelada','no_asistio')"/>
                </list>
            </field>
        </record>

        <!-- Cita Kanban -->
        <record id="view_clinica_cita_kanban" model="ir.ui.view">
            <field name="name">clinica.cita.kanban</field>
            <field name="model">clinica.cita</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="paciente_id"/>
                    <field name="dentista_id"/>
                    <field name="fecha_inicio"/>
                    <field name="tipo_cita"/>
                    <field name="state"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="paciente_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="tipo_cita"/> — <field name="dentista_id"/>
                                    </div>
                                    <div><field name="fecha_inicio" widget="datetime"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Cita Calendar -->
        <record id="view_clinica_cita_calendar" model="ir.ui.view">
            <field name="name">clinica.cita.calendar</field>
            <field name="model">clinica.cita</field>
            <field name="arch" type="xml">
                <calendar string="Citas" date_start="fecha_inicio" date_stop="fecha_fin"
                          color="color" mode="week" quick_add="False">
                    <field name="paciente_id"/>
                    <field name="dentista_id"/>
                    <field name="tipo_cita"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- Cita Action -->
        <record id="action_clinica_cita" model="ir.actions.act_window">
            <field name="name">Citas</field>
            <field name="res_model">clinica.cita</field>
            <field name="view_mode">calendar,list,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_clinica_cita_calendar')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinica_cita_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_clinica_cita_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinica_cita_form')}),
            ]"/>
        </record>

    </data>
</odoo>
