<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Documento Medico Form -->
        <record id="view_clinica_documento_medico_form" model="ir.ui.view">
            <field name="name">clinica.documento.medico.form</field>
            <field name="model">clinica.documento.medico</field>
            <field name="arch" type="xml">
                <form string="Documento Médico">
                    <header>
                        <button name="action_marcar_revisado" string="Marcar como Revisado"
                                type="object" class="btn-success"
                                invisible="state != 'pendiente_revision'"
                                groups="clinica_dental.group_dentista,clinica_dental.group_admin"/>
                        <button name="action_archivar" string="Archivar" type="object"
                                invisible="state != 'revisado'"
                                groups="clinica_dental.group_dentista,clinica_dental.group_admin"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="pendiente_revision,revisado,archivado"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="nombre" placeholder="Nombre del documento..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información del Documento">
                                <field name="paciente_id"/>
                                <field name="tipo_documento"/>
                                <field name="fecha"/>
                                <field name="subido_por" readonly="1"/>
                                <field name="es_confidencial"/>
                            </group>
                            <group string="Destino">
                                <field name="dentista_id"/>
                                <field name="cita_id"/>
                                <field name="tratamiento_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Imagen / Archivo">
                                <group>
                                    <field name="imagen_principal" widget="image"
                                           options="{'size': (800, 600)}"
                                           filename="imagen_filename"/>
                                    <field name="imagen_filename" invisible="1"/>
                                </group>
                                <separator string="Archivos Adjuntos Adicionales"/>
                                <field name="adjunto_ids" widget="many2many_binary"
                                       string="Adjuntos"/>
                            </page>
                            <page string="Descripción">
                                <field name="descripcion"
                                       placeholder="Notas sobre el documento o imagen..."/>
                            </page>
                            <page string="Notas del Dentista">
                                <!-- Editable for dentist/admin -->
                                <field name="notas_dentista"
                                       placeholder="El dentista agregará sus observaciones aquí..."
                                       readonly="state not in ('pendiente_revision','revisado')"
                                       groups="clinica_dental.group_dentista,clinica_dental.group_admin"/>
                                <!-- Read-only for receptionist/radiologist -->
                                <field name="notas_dentista" readonly="1"
                                       groups="clinica_dental.group_recepcionista,clinica_dental.group_radiologo"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Documento Medico List -->
        <record id="view_clinica_documento_medico_list" model="ir.ui.view">
            <field name="name">clinica.documento.medico.list</field>
            <field name="model">clinica.documento.medico</field>
            <field name="arch" type="xml">
                <list string="Documentos Médicos"
                      decoration-warning="state == 'pendiente_revision'"
                      decoration-success="state == 'revisado'"
                      decoration-muted="state == 'archivado'">
                    <field name="fecha"/>
                    <field name="nombre"/>
                    <field name="tipo_documento"/>
                    <field name="paciente_id"/>
                    <field name="dentista_id"/>
                    <field name="subido_por"/>
                    <field name="state" widget="badge"
                           decoration-warning="state == 'pendiente_revision'"
                           decoration-success="state == 'revisado'"
                           decoration-muted="state == 'archivado'"/>
                    <field name="es_confidencial" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Documento Medico Kanban -->
        <record id="view_clinica_documento_medico_kanban" model="ir.ui.view">
            <field name="name">clinica.documento.medico.kanban</field>
            <field name="model">clinica.documento.medico</field>
            <field name="arch" type="xml">
                <kanban default_group_by="dentista_id">
                    <field name="nombre"/>
                    <field name="tipo_documento"/>
                    <field name="paciente_id"/>
                    <field name="fecha"/>
                    <field name="state"/>
                    <field name="imagen_principal"/>
                    <templates>
                        <t t-name="card">
                            <div t-if="record.imagen_principal.value"
                                 class="text-center mb-2">
                                <img t-att-src="'data:image/png;base64,' + record.imagen_principal.value"
                                     alt="Imagen del documento"
                                     style="max-height:120px;max-width:180px;object-fit:cover;"/>
                            </div>
                            <strong><field name="nombre"/></strong>
                            <div class="text-muted"><field name="tipo_documento"/></div>
                            <div><field name="paciente_id"/></div>
                            <div><field name="fecha"/></div>
                            <div class="mt-1">
                                <span t-attf-class="badge #{record.state.raw_value == 'pendiente_revision' and 'bg-warning text-dark' or record.state.raw_value == 'revisado' and 'bg-success' or 'bg-secondary'}">
                                    <field name="state"/>
                                </span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Documento Medico Pendientes List -->
        <record id="view_clinica_documento_medico_pendientes_list" model="ir.ui.view">
            <field name="name">clinica.documento.medico.pendientes.list</field>
            <field name="model">clinica.documento.medico</field>
            <field name="arch" type="xml">
                <list string="Documentos Pendientes de Revisión">
                    <field name="fecha"/>
                    <field name="nombre"/>
                    <field name="tipo_documento"/>
                    <field name="paciente_id"/>
                    <field name="subido_por"/>
                    <field name="state" widget="badge"
                           decoration-warning="state == 'pendiente_revision'"/>
                </list>
            </field>
        </record>

        <!-- Action: all documents -->
        <record id="action_clinica_documento_medico" model="ir.actions.act_window">
            <field name="name">Documentos e Imágenes</field>
            <field name="res_model">clinica.documento.medico</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinica_documento_medico_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_clinica_documento_medico_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinica_documento_medico_form')}),
            ]"/>
        </record>

        <!-- Action: pending documents -->
        <record id="action_clinica_documento_medico_pendientes" model="ir.actions.act_window">
            <field name="name">Documentos Pendientes</field>
            <field name="res_model">clinica.documento.medico</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'pendiente_revision')]</field>
            <field name="context">{'default_state': 'pendiente_revision'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinica_documento_medico_pendientes_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinica_documento_medico_form')}),
            ]"/>
        </record>

    </data>
</odoo>
