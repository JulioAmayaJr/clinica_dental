<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tratamiento Form -->
        <record id="view_clinica_tratamiento_form" model="ir.ui.view">
            <field name="name">clinica.tratamiento.form</field>
            <field name="model">clinica.tratamiento</field>
            <field name="arch" type="xml">
                <form string="Tratamiento Dental">
                    <header>
                        <button name="action_iniciar" string="Iniciar" type="object"
                                class="btn-primary"
                                invisible="state != 'planificado'"/>
                        <button name="action_completar" string="Completar" type="object"
                                class="btn-success"
                                invisible="state != 'en_proceso'"/>
                        <button name="action_cancelar" string="Cancelar" type="object"
                                class="btn-danger"
                                invisible="state in ('completado','cancelado')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="planificado,en_proceso,completado"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Paciente y Dentista">
                                <field name="paciente_id"/>
                                <field name="dentista_id"/>
                                <field name="cita_id"/>
                                <field name="fecha"/>
                            </group>
                            <group string="Detalle del Tratamiento">
                                <field name="tipo_tratamiento"/>
                                <field name="pieza_dental"/>
                                <field name="producto_id"/>
                                <field name="cantidad"/>
                                <field name="precio_unitario"/>
                                <field name="subtotal" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="descripcion" placeholder="Descripción del tratamiento..."/>
                            </page>
                            <page string="Notas Clínicas">
                                <field name="notas_clinicas" placeholder="Notas clínicas del dentista..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tratamiento List -->
        <record id="view_clinica_tratamiento_list" model="ir.ui.view">
            <field name="name">clinica.tratamiento.list</field>
            <field name="model">clinica.tratamiento</field>
            <field name="arch" type="xml">
                <list string="Tratamientos"
                      decoration-success="state == 'completado'"
                      decoration-warning="state == 'planificado'"
                      decoration-info="state == 'en_proceso'"
                      decoration-danger="state == 'cancelado'">
                    <field name="fecha"/>
                    <field name="paciente_id"/>
                    <field name="dentista_id"/>
                    <field name="tipo_tratamiento"/>
                    <field name="pieza_dental"/>
                    <field name="subtotal" widget="monetary"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completado'"
                           decoration-warning="state == 'planificado'"
                           decoration-info="state == 'en_proceso'"
                           decoration-danger="state == 'cancelado'"/>
                </list>
            </field>
        </record>

        <!-- Tratamiento Kanban -->
        <record id="view_clinica_tratamiento_kanban" model="ir.ui.view">
            <field name="name">clinica.tratamiento.kanban</field>
            <field name="model">clinica.tratamiento</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="paciente_id"/>
                    <field name="tipo_tratamiento"/>
                    <field name="dentista_id"/>
                    <field name="subtotal"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <strong><field name="paciente_id"/></strong>
                            <div><field name="tipo_tratamiento"/></div>
                            <div><field name="dentista_id"/></div>
                            <div class="text-end">
                                <field name="subtotal" widget="monetary"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tratamiento Action -->
        <record id="action_clinica_tratamiento" model="ir.actions.act_window">
            <field name="name">Tratamientos</field>
            <field name="res_model">clinica.tratamiento</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinica_tratamiento_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_clinica_tratamiento_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_clinica_tratamiento_form')}),
            ]"/>
        </record>

    </data>
</odoo>
