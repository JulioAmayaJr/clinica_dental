<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend sale.order form — Odoo 19 anchors verified:
             //field[@name='validity_date']  → unique field in header group of sale form
             //page[@name='other_information'] → real page name confirmed in container
        -->
        <record id="view_sale_order_clinica_presupuesto_form" model="ir.ui.view">
            <field name="name">sale.order.clinica.presupuesto.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Inject hidden flag + tipo_presupuesto after validity_date (unique anchor) -->
                <xpath expr="//field[@name='validity_date']" position="after">
                    <field name="es_presupuesto_dental" invisible="1"/>
                    <field name="tipo_presupuesto"
                           invisible="not es_presupuesto_dental"/>
                </xpath>

                <!-- Notas clínicas tab after other_information (confirmed name in Odoo 19) -->
                <xpath expr="//page[@name='other_information']" position="after">
                    <page string="Notas Clínicas" name="notas_clinicas_dental"
                          invisible="not es_presupuesto_dental">
                        <field name="notas_clinicas"
                               placeholder="Notas clínicas relacionadas con el presupuesto..."/>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- Extend sale order list view (view_quotation_tree_with_onboarding confirmed exists) -->
        <record id="view_sale_order_clinica_presupuesto_list" model="ir.ui.view">
            <field name="name">sale.order.clinica.presupuesto.list</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="tipo_presupuesto" optional="show"/>
                    <field name="es_presupuesto_dental" column_invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Action: Dental Budgets — filters sale.order by es_presupuesto_dental -->
        <record id="action_clinica_presupuesto" model="ir.actions.act_window">
            <field name="name">Presupuestos Dentales</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('es_presupuesto_dental', '=', True)]</field>
            <field name="context">{'default_es_presupuesto_dental': True}</field>
        </record>

    </data>
</odoo>
