<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend sale.order form to show dental budget fields -->
        <record id="view_sale_order_clinica_presupuesto_form" model="ir.ui.view">
            <field name="name">sale.order.clinica.presupuesto.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Badge "Presupuesto Dental" visible only when es_presupuesto_dental -->
                <xpath expr="//div[@class='oe_title']//h1" position="before">
                    <h2 class="text-muted"
                        attrs="{'invisible': [('es_presupuesto_dental', '=', False)]}">
                        Presupuesto Dental
                    </h2>
                </xpath>
                <!-- Inject dental fields after partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="es_presupuesto_dental" invisible="1"/>
                    <field name="tipo_presupuesto"
                           attrs="{'invisible': [('es_presupuesto_dental', '=', False)]}"/>
                </xpath>
                <!-- Notas clínicas tab after other_info -->
                <xpath expr="//page[@name='other_info']" position="after">
                    <page string="Notas Clínicas" name="notas_clinicas_dental"
                          attrs="{'invisible': [('es_presupuesto_dental', '=', False)]}">
                        <field name="notas_clinicas"
                               placeholder="Notas clínicas relacionadas con el presupuesto..."/>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Extend sale.order list to show dental budget fields -->
        <record id="view_sale_order_clinica_presupuesto_list" model="ir.ui.view">
            <field name="name">sale.order.clinica.presupuesto.list</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="tipo_presupuesto"
                           attrs="{'invisible': [('es_presupuesto_dental', '=', False)]}"/>
                    <field name="es_presupuesto_dental" column_invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Action: Dental Budgets — filters sale.order -->
        <record id="action_clinica_presupuesto" model="ir.actions.act_window">
            <field name="name">Presupuestos Dentales</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('es_presupuesto_dental', '=', True)]</field>
            <field name="context">{
                'default_es_presupuesto_dental': True,
                'search_default_es_presupuesto_dental': 1
            }</field>
        </record>

    </data>
</odoo>
