<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend base.view_partner_form (Odoo 19 structure verified) -->
        <!-- Anchors used:
             - //div[@name='button_box']   → smart button "Nueva Cita"
             - //field[@name='vat']        → inject es_paciente toggle
             - //page[@name='sales_purchases'] → insert clinical tabs before it
        -->
        <record id="view_clinica_paciente_form" model="ir.ui.view">
            <field name="name">res.partner.clinica.paciente.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Smart button: Nueva Cita (visible only for patients) -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_nueva_cita" type="object"
                            class="oe_stat_button" icon="fa-calendar-plus-o"
                            invisible="not es_paciente">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Nueva Cita</span>
                        </div>
                    </button>
                </xpath>

                <!-- Inject es_paciente field after vat (right group, safe anchor) -->
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="es_paciente" string="Es Paciente" widget="boolean_toggle"/>
                </xpath>

                <!-- Clinical tabs — inserted before sales_purchases tab -->
                <xpath expr="//page[@name='sales_purchases']" position="before">

                    <page string="Información General" name="clinica_general"
                          invisible="not es_paciente">
                        <group>
                            <group string="Datos Personales">
                                <field name="fecha_nacimiento"/>
                                <field name="edad" readonly="1"/>
                                <field name="genero"/>
                                <field name="grupo_sanguineo"/>
                            </group>
                            <group string="Contacto de Emergencia">
                                <field name="contacto_emergencia"/>
                                <field name="telefono_emergencia"/>
                            </group>
                        </group>
                    </page>

                    <page string="Historia Clínica" name="clinica_historia"
                          invisible="not es_paciente">
                        <group>
                            <group string="Antecedentes Médicos">
                                <field name="alergias"/>
                                <field name="enfermedades_sistemicas"/>
                                <field name="medicamentos_actuales"/>
                                <field name="fumador"/>
                            </group>
                        </group>
                        <separator string="Historia Clínica Detallada"/>
                        <field name="historia_clinica" nolabel="1"
                               placeholder="Historia clínica detallada..."/>
                    </page>

                    <page string="Citas" name="clinica_citas"
                          invisible="not es_paciente">
                        <field name="cita_ids" readonly="1">
                            <list>
                                <field name="fecha_inicio"/>
                                <field name="tipo_cita"/>
                                <field name="dentista_id"/>
                                <field name="motivo"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'completada'"
                                       decoration-warning="state == 'agendada'"
                                       decoration-info="state in ('confirmada','en_proceso')"
                                       decoration-danger="state in ('cancelada','no_asistio')"/>
                            </list>
                        </field>
                    </page>

                    <page string="Tratamientos" name="clinica_tratamientos"
                          invisible="not es_paciente">
                        <field name="tratamiento_ids" readonly="1">
                            <list>
                                <field name="fecha"/>
                                <field name="tipo_tratamiento"/>
                                <field name="pieza_dental"/>
                                <field name="dentista_id"/>
                                <field name="subtotal" widget="monetary"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'completado'"
                                       decoration-warning="state == 'planificado'"
                                       decoration-info="state == 'en_proceso'"
                                       decoration-danger="state == 'cancelado'"/>
                            </list>
                        </field>
                    </page>

                    <page string="Odontogramas" name="clinica_odontogramas"
                          invisible="not es_paciente">
                        <field name="odontograma_ids" readonly="1">
                            <list>
                                <field name="fecha"/>
                                <field name="notas_generales"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'confirmado'"
                                       decoration-muted="state == 'borrador'"/>
                            </list>
                        </field>
                    </page>

                    <page string="Documentos e Imágenes" name="clinica_documentos"
                          invisible="not es_paciente">
                        <field name="documento_medico_ids">
                            <kanban>
                                <field name="nombre"/>
                                <field name="tipo_documento"/>
                                <field name="fecha"/>
                                <field name="subido_por"/>
                                <field name="dentista_id"/>
                                <field name="state"/>
                                <field name="imagen_principal"/>
                                <templates>
                                    <t t-name="card">
                                        <div t-if="record.imagen_principal.value"
                                             class="text-center mb-2">
                                            <img t-att-src="'data:image/png;base64,' + record.imagen_principal.value"
                                                 style="max-height:90px;max-width:140px;object-fit:cover;"/>
                                        </div>
                                        <strong><field name="nombre"/></strong>
                                        <div class="text-muted"><field name="tipo_documento"/></div>
                                        <div><field name="fecha"/></div>
                                        <div>
                                            <span t-attf-class="badge #{record.state.raw_value == 'pendiente_revision' and 'bg-warning text-dark' or record.state.raw_value == 'revisado' and 'bg-success' or 'bg-secondary'}">
                                                <field name="state"/>
                                            </span>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>

                    <page string="Presupuestos" name="clinica_presupuestos"
                          invisible="not es_paciente">
                        <field name="presupuesto_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="date_order"/>
                                <field name="tipo_presupuesto"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="state" widget="badge"
                                       decoration-success="state in ('sale','done')"
                                       decoration-warning="state == 'draft'"
                                       decoration-info="state == 'sent'"/>
                            </list>
                        </field>
                    </page>

                </xpath>

            </field>
        </record>

        <!-- Standalone list view for the Patients menu -->
        <record id="view_clinica_paciente_list" model="ir.ui.view">
            <field name="name">clinica.paciente.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Pacientes">
                    <field name="name"/>
                    <field name="edad"/>
                    <field name="genero"/>
                    <field name="grupo_sanguineo"/>
                    <field name="phone"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <!-- Action: opens res.partner filtered to patients.
             Form view is NOT specified here — the inherited view
             (view_clinica_paciente_form) is applied automatically by Odoo. -->
        <record id="action_clinica_paciente" model="ir.actions.act_window">
            <field name="name">Pacientes</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('es_paciente', '=', True)]</field>
            <field name="context">{'default_es_paciente': True}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinica_paciente_list')}),
            ]"/>
        </record>

    </data>
</odoo>
