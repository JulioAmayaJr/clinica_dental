<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="group_recepcionista" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="comment">Can create/edit patients and appointments. Cannot see confidential documents or edit dentist notes.</field>
        </record>

        <record id="group_radiologo" model="res.groups">
            <field name="name">Radiologist / Assistant</field>
            <field name="comment">Can create and upload medical documents. Can only see documents they uploaded.</field>
        </record>

        <record id="group_dentista" model="res.groups">
            <field name="name">Dentist</field>
            <field name="comment">Can view and edit all patient records, add dentist notes and mark documents as reviewed.</field>
            <field name="implied_ids" eval="[(4, ref('clinica_dental.group_recepcionista'))]"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Clinic Administrator</field>
            <field name="comment">Full access to all clinic data.</field>
            <field name="implied_ids" eval="[(4, ref('clinica_dental.group_dentista'))]"/>
        </record>

        <!-- Odoo 19: user assignment goes on res.users via group_ids, not on res.groups via users -->
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('clinica_dental.group_admin'))]"/>
        </record>

    </data>
</odoo>
